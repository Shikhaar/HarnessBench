diff --git a/src/retry.js b/src/retry.js
index 182d1f2..e36c908 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,2 +1,16 @@
-// Retry module stub
-module.exports = {};
+async function executeWithRetry(fn, { maxRetries = 3, delayMs = 10 } = {}) {
+  let lastError;
+  for (let i = 0; i < maxRetries; i++) {
+    try {
+      return await fn();
+    } catch (err) {
+      lastError = err;
+      if (delayMs > 0) {
+        await new Promise(res => setTimeout(res, delayMs));
+      }
+    }
+  }
+  throw lastError;
+}
+
+module.exports = { executeWithRetry };
